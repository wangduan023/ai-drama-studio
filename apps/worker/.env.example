# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Worker 并发配置 =====
# LLM 文本生成任务并发数（较高，因为主要是 API 调用等待）
QUEUE_CONCURRENCY_LLM=50

# 图片生成任务并发数（中等，受图像生成 API 限流影响）
QUEUE_CONCURRENCY_IMAGE=20

# 视频生成任务并发数（较低，视频生成耗时长）
QUEUE_CONCURRENCY_VIDEO=5

# 语音生成任务并发数（中等）
QUEUE_CONCURRENCY_VOICE=20

# ===== 环境变量 =====
NODE_ENV=development

# ===== AI 服务配置（示例） =====
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# ===== 存储服务配置 =====
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=
