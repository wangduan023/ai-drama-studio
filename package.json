{
  "name": "ai-drama-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI Drama Studio - AI 短剧/漫剧生成平台",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm run dev:web\" \"pnpm run dev:worker\"",
    "dev:web": "cd apps/web && next dev -p 3333 -H 0.0.0.0",
    "dev:worker": "cd apps/worker && tsx watch --env-file=.env index.ts",
    "build": "npm run build:prisma && next build",
    "build:prisma": "npx prisma generate",
    "start": "concurrently --kill-others \"pnpm run start:web\" \"pnpm run start:worker\"",
    "start:web": "next start -p 3333 -H 0.0.0.0",
    "start:worker": "cd apps/worker && tsx --env-file=.env index.ts",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "tsx packages/db/src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "cd apps/web && pnpm test:e2e",
    "test:e2e:ui": "cd apps/web && pnpm test:e2e:ui",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.2.0",
    "@bull-board/api": "^6.16.4",
    "@bull-board/express": "^6.16.4",
    "@prisma/client": "^6.1.0",
    "ai": "^4.2.0",
    "bullmq": "^5.67.0",
    "concurrently": "^9.1.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "mysql2": "^3.12.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.11",
    "prisma": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
