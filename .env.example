# AI API 配置（请填入实际的 API Key）
# 复制此文件为 .env 并填入有效值

# ==================== 数据库配置 ====================
# 数据库提供者：mysql 或 sqlite
DATABASE_PROVIDER="sqlite"

# SQLite 配置（开发/测试环境）
DATABASE_URL="file:./dev.db"

# MySQL 配置（生产环境）- 取消注释使用
# DATABASE_PROVIDER="mysql"
# DATABASE_URL="mysql://root:aidrama123@localhost:3306/ai_drama_studio"

# ==================== Redis 配置 ====================
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==================== SSE 配置 ====================
SSE_STREAM_EPHEMERAL_ENABLED=true

# ==================== 认证配置 ====================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-2026"

# ==================== 存储配置 ====================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads

# ==================== 内部密钥 ====================
CRON_SECRET="change-this-cron-secret"
INTERNAL_TASK_TOKEN="change-this-task-token"
API_ENCRYPTION_KEY="change-this-encryption-key-2026"

# ==================== Bull Board 配置 ====================
BULL_BOARD_HOST=0.0.0.0
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USER=""
BULL_BOARD_PASSWORD=""

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=pretty
LOG_SERVICE=ai-drama-studio
LOG_DEBUG_ENABLED=true

# ==================== 计费配置 ====================
BILLING_MODE=OFF

# ==================== Worker 配置 ====================
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000
QUEUE_CONCURRENCY_IMAGE=50
QUEUE_CONCURRENCY_VIDEO=50
QUEUE_CONCURRENCY_VOICE=20
QUEUE_CONCURRENCY_TEXT=50

# ==================== AI API 配置 ====================
# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Google
GOOGLE_API_KEY=""
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# 豆包（字节）
DOUBAO_API_KEY=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# 可灵（快手）
KLING_API_KEY=""
KLING_BASE_URL="https://api.klingai.com"

# Vidu
VIDU_API_KEY=""
VIDU_BASE_URL="https://api.vidu.cn"

# ==================== HTTP 代理配置 (可选) ====================
# 用于国内访问国外 AI API (OpenAI/Anthropic/Google 等)
# 如果不需要代理，请留空或注释
HTTP_PROXY_HOST=""
HTTP_PROXY_PORT=7890
HTTP_PROXY_USERNAME=""
HTTP_PROXY_PASSWORD=""
