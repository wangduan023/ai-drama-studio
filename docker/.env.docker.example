# AI Drama Studio - Docker 环境配置示例
# 复制此文件为 .env 并填入实际的 API Keys

# ==================== 数据库配置 (Docker 内部网络) ====================
# 当使用 Docker Compose 时，数据库连接使用容器内部网络
DATABASE_PROVIDER=mysql
DATABASE_URL="mysql://root:aidrama123@mysql:3306/ai_drama_studio"

# ==================== Redis 配置 (Docker 内部网络) ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==================== SSE 配置 ====================
SSE_STREAM_EPHEMERAL_ENABLED=true

# ==================== 认证配置 ====================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ai-drama-studio-default-secret-2026"

# ==================== 存储配置 ====================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/uploads

# ==================== 内部密钥配置 ====================
# 警告：请修改以下默认值以确保安全！
CRON_SECRET="ai-drama-studio-cron-secret"
INTERNAL_TASK_TOKEN="ai-drama-studio-task-token"
API_ENCRYPTION_KEY="ai-drama-studio-fixed-key-2026"

# ==================== Bull Board 配置 ====================
BULL_BOARD_HOST=0.0.0.0
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USER=""
BULL_BOARD_PASSWORD=""

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE=ai-drama-studio

# ==================== 计费配置 ====================
BILLING_MODE=OFF

# ==================== Worker 配置 ====================
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000
QUEUE_CONCURRENCY_IMAGE=50
QUEUE_CONCURRENCY_VIDEO=50
QUEUE_CONCURRENCY_VOICE=20
QUEUE_CONCURRENCY_TEXT=50

# ==================== AI API 配置（必填）====================
# 请填入实际的 API Keys，否则 AI 功能无法正常工作

# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic (Claude)
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Google (Gemini)
GOOGLE_API_KEY=""
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# 豆包（字节跳动）
DOUBAO_API_KEY=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# 可灵（快手）
KLING_API_KEY=""
KLING_BASE_URL="https://api.klingai.com"

# Vidu
VIDU_API_KEY=""
VIDU_BASE_URL="https://api.vidu.cn"

# ==================== HTTP 代理配置 (可选) ====================
# 用于国内访问国外 AI API (OpenAI/Anthropic/Google 等)
# 如果不需要代理，请留空或注释
HTTP_PROXY_HOST=""
HTTP_PROXY_PORT=7890
HTTP_PROXY_USERNAME=""
HTTP_PROXY_PASSWORD=""
